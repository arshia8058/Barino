# Barino is a static GitHub Pages app; it does not load .env files at runtime.
# Copy only these PUBLIC browser values into supabase-config.js for local deployment.
BARINO_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
BARINO_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY

# Do not put service_role keys, database passwords, JWT secrets, or admin passwords here.
# The database password used by the optional GitHub Actions migration workflow belongs
# only in the repository's Actions secret store and is intentionally not listed here.
